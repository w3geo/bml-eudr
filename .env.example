# SERVER_PRESET=digital-ocean
NUXT_SESSION_PASSWORD=password-with-at-least-32-characters
NUXT_OAUTH_IDAUSTRIA_CLIENT_ID="my-idaustria-oauth-app-id"
NUXT_OAUTH_IDAUSTRIA_CLIENT_SECRET="my-idaustria-oauth-app-secret"
NUXT_OAUTH_IDAUSTRIA_AUTHORIZATION_URL=https://eid2.oesterreich.gv.at/auth/idp/profile/oidc/authorize
NUXT_OAUTH_IDAUSTRIA_TOKEN_URL=https://eid2.oesterreich.gv.at/auth/idp/profile/oidc/token
NUXT_SMTP_FROM="from@example.com"
NUXT_SMTP_HOST="smtp.example.com"
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE="false"
NUXT_SMTP_USER="my-NUXT_SMTP-user"
NUXT_SMTP_PASS="my-NUXT_SMTP-pass"
DATABASE_URL="my-database-url"
DATABASE_CA_CERT="my-database-ca-cert"
AMA_CLIENT_ID="my-ama-client-id"
AMA_CLIENT_SECRET="my-ama-client-secret"
AMA_CERT="my-ama-client-cert"
AMA_KEY="my-ama-client-key"
AMA_CATTLE_PATH="/api/webservices/v1/stage/entwaldungs-vo"
TRACES_WS_URL="https://acceptance.eudr.webcloud.ec.europa.eu/tracesnt/ws/"
TRACES_WS_CLIENT_ID="eudr-test"
TRACES_USERNAME="my-traces-username"
TRACES_AUTHKEY="my-traces-authkey"
